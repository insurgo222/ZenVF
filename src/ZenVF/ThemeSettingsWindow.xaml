<Window x:Class="ZenVF.ThemeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ZenVF · 外观与主题"
        Width="560"
        Height="700"
        MinWidth="520"
        MinHeight="640"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Grid Width="18" Height="18" Margin="0,0,9,0">
                            <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" />
                            <UniformGrid Columns="2" Rows="2" Margin="2">
                                <Border Background="{DynamicResource CopperBrush}" Margin="0,0,1,1" />
                                <Border Background="{DynamicResource TealBrush}" Margin="1,0,0,1" />
                                <Border Background="{DynamicResource MutedBrush}" Margin="0,1,1,0" />
                                <Border Background="{DynamicResource AccentBrush}" Margin="1,1,0,0" />
                            </UniformGrid>
                        </Grid>
                        <TextBlock Text="外观与主题" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="Close_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                            AutomationProperties.Name="关闭"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="关闭" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="18,16,10,8">
                <StackPanel Margin="0,0,8,0">

                    <TextBlock Text="外观" Style="{StaticResource H1}" FontSize="20" />
                    <TextBlock Text="主题跟随 Windows，也可以固定。" Style="{StaticResource SmallMuted}" Margin="0,4,0,0" />

                    <TextBlock Text="主题模式" Style="{StaticResource CardTitle}" Margin="0,18,0,8" />
                    <UniformGrid Columns="3">
                        <RadioButton x:Name="SystemModeRadio" GroupName="ThemeMode" Tag="System"
                                     Style="{StaticResource ThemeModeRadio}" Margin="0,0,7,0"
                                     AutomationProperties.Name="跟随系统"
                                     Checked="Mode_Checked">
                            <StackPanel>
                                <Border Height="56" Background="#E9EDEF" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="7">
                                            <Border Height="2" Background="#C9D2D7" />
                                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                                <Border Height="12" Background="#F7F8F8" BorderBrush="#C9D2D7" BorderThickness="1" Margin="0,0,2,2" />
                                                <Border Height="12" Background="#F7F8F8" BorderBrush="#C9D2D7" BorderThickness="1" Margin="2,0,0,2" />
                                                <Border Height="12" Background="#F7F8F8" BorderBrush="#C9D2D7" BorderThickness="1" Margin="0,2,2,0" />
                                                <Border Height="12" Background="#F7F8F8" BorderBrush="#C9D2D7" BorderThickness="1" Margin="2,2,0,0" />
                                            </UniformGrid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Background="#0B0E11" Margin="0">
                                            <Border Height="2" Background="#2A343D" Margin="7,7,7,0" />
                                            <UniformGrid Columns="2" Margin="7,6,7,0">
                                                <Border Height="12" Background="#141B21" BorderBrush="#2A343D" BorderThickness="1" Margin="0,0,2,2" />
                                                <Border Height="12" Background="#141B21" BorderBrush="#2A343D" BorderThickness="1" Margin="2,0,0,2" />
                                                <Border Height="12" Background="#141B21" BorderBrush="#2A343D" BorderThickness="1" Margin="0,2,2,0" />
                                                <Border Height="12" Background="#141B21" BorderBrush="#2A343D" BorderThickness="1" Margin="2,2,0,0" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="跟随系统" FontSize="11.5" FontWeight="SemiBold" Margin="1,8,0,0" />
                                <TextBlock Text="Windows 设置" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                                           Margin="1,2,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="LightModeRadio" GroupName="ThemeMode" Tag="Light"
                                     Style="{StaticResource ThemeModeRadio}" Margin="0,0,7,0"
                                     AutomationProperties.Name="浅色"
                                     Checked="Mode_Checked">
                            <StackPanel>
                                <Border Height="56" Background="#E9EDEF" ClipToBounds="True">
                                    <StackPanel Margin="7">
                                        <Border Height="2" Background="#C9D2D7" />
                                        <UniformGrid Columns="3" Margin="0,6,0,0">
                                            <Border Height="26" Background="#F7F8F8" BorderBrush="#C9D2D7" BorderThickness="1" Margin="0,0,2,0" />
                                            <Border Height="26" Background="#F7F8F8" BorderBrush="#C9D2D7" BorderThickness="1" Margin="2,0,2,0" />
                                            <Border Height="26" Background="#F7F8F8" BorderBrush="#C9D2D7" BorderThickness="1" Margin="2,0,0,0" />
                                        </UniformGrid>
                                        <Border Height="3" Background="#9A4E12" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="浅色" FontSize="11.5" FontWeight="SemiBold" Margin="1,8,0,0" />
                                <TextBlock Text="陶瓷封装" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                                           Margin="1,2,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="DarkModeRadio" GroupName="ThemeMode" Tag="Dark"
                                     Style="{StaticResource ThemeModeRadio}"
                                     AutomationProperties.Name="深色"
                                     Checked="Mode_Checked">
                            <StackPanel>
                                <Border Height="56" Background="#0B0E11" ClipToBounds="True">
                                    <StackPanel Margin="7">
                                        <Border Height="2" Background="#2A343D" />
                                        <UniformGrid Columns="3" Margin="0,6,0,0">
                                            <Border Height="26" Background="#141B21" BorderBrush="#2A343D" BorderThickness="1" Margin="0,0,2,0" />
                                            <Border Height="26" Background="#141B21" BorderBrush="#2A343D" BorderThickness="1" Margin="2,0,2,0" />
                                            <Border Height="26" Background="#141B21" BorderBrush="#2A343D" BorderThickness="1" Margin="2,0,0,0" />
                                        </UniformGrid>
                                        <Border Height="3" Background="#C87533" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="深色" FontSize="11.5" FontWeight="SemiBold" Margin="1,8,0,0" />
                                <TextBlock Text="硅片" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                                           Margin="1,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <TextBlock Text="主题色" Style="{StaticResource CardTitle}" Margin="0,20,0,8" />
                    <WrapPanel x:Name="AccentPanel" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="自定义" Style="{StaticResource SmallMuted}" VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBox x:Name="AccentHexBox" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                                 Text="#5BC0BE" MaxLength="9" ToolTip="输入 #RRGGBB"
                                 AutomationProperties.Name="自定义主题色"
                                 KeyDown="AccentHex_KeyDown" />
                        <Button Grid.Column="2" Content="应用" Style="{StaticResource SecondaryButton}"
                                AutomationProperties.Name="应用自定义主题色"
                                Click="ApplyAccent_Click" Padding="12,7" />
                    </Grid>
                    <TextBlock x:Name="AccentStatusText" Text="" FontSize="9.5" Foreground="{DynamicResource RedBrush}"
                               Margin="0,5,0,0" />

                    <Border Style="{StaticResource SectionRule}" Margin="0,18,0,12" />

                    <TextBlock Text="预览" Style="{StaticResource CardTitle}" />
                    <Border Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" Padding="14" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="电压—频率响应" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border Width="36" Height="30" Background="{DynamicResource CoreBlockBrush}"
                                            BorderBrush="{DynamicResource CoreBlockBorderBrush}" BorderThickness="1" Margin="0,0,4,0">
                                        <Grid>
                                            <Rectangle Height="3" VerticalAlignment="Bottom" Fill="{DynamicResource CopperBrush}" Opacity="0.45" />
                                            <TextBlock Text="1.148" FontFamily="Cascadia Mono, Consolas" FontSize="9"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </Grid>
                                    </Border>
                                    <Border Width="36" Height="30" Background="{DynamicResource CoreBlockBrush}"
                                            BorderBrush="{DynamicResource CopperBrush}" BorderThickness="1" Margin="0,0,4,0">
                                        <Grid>
                                            <Rectangle Height="3" VerticalAlignment="Bottom" Fill="{DynamicResource CopperBrush}" Opacity="0.85" />
                                            <TextBlock Text="1.162" FontFamily="Cascadia Mono, Consolas" FontSize="9"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </Grid>
                                    </Border>
                                    <Border Width="36" Height="30" Background="{DynamicResource CoreBlockBrush}"
                                            BorderBrush="{DynamicResource CoreBlockBorderBrush}" BorderThickness="1" Margin="0,0,4,0">
                                        <Grid>
                                            <Rectangle Height="3" VerticalAlignment="Bottom" Fill="{DynamicResource CopperBrush}" Opacity="0.3" />
                                            <TextBlock Text="1.140" FontFamily="Cascadia Mono, Consolas" FontSize="9"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="开始全核测试" Style="{StaticResource PrimaryButton}"
                                            Padding="14,7" Margin="0,0,8,0" />
                                    <Button Content="每核电压" Style="{StaticResource SecondaryButton}"
                                            Padding="14,7" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="设置保存在本机。选择“跟随系统”时，ZenVF 会跟随 Windows 的浅色/深色模式。"
                               Style="{StaticResource SmallMuted}" TextWrapping="Wrap" LineHeight="15"
                               Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="18,0">
                <Grid>
                    <TextBlock Text="更改会立即生效" Style="{StaticResource SmallMuted}" VerticalAlignment="Center" />
                    <Button Content="完成" Style="{StaticResource PrimaryButton}" Click="Done_Click"
                            AutomationProperties.Name="完成"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="26,9" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
