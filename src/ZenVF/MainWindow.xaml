<Window x:Class="ZenVF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:svc="clr-namespace:ZenVF.Services"
        mc:Ignorable="d"
        Title="ZenVF 1.0.7"
        Width="1500"
        Height="940"
        MinWidth="1180"
        MinHeight="760"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Key/value rows: label, dot leader and value all sit on the row's
             bottom edge so their baselines meet (they used to be ~8px apart). -->
        <Style x:Key="KvLabel" TargetType="TextBlock" BasedOn="{StaticResource SmallMuted}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Readout}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="LogLevelText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static svc:LogLevel.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static svc:LogLevel.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource YellowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static svc:LogLevel.Error}">
                    <Setter Property="Foreground" Value="{DynamicResource RedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static svc:LogLevel.Debug}">
                    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- Die label bar -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Grid Width="20" Height="20" Margin="0,0,9,0">
                            <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" />
                            <UniformGrid Columns="2" Rows="2" Margin="2">
                                <Border Background="{DynamicResource CopperBrush}" Margin="0,0,1,1" />
                                <Border Background="{DynamicResource TealBrush}" Margin="1,0,0,1" />
                                <Border Background="{DynamicResource MutedBrush}" Margin="0,1,1,0" />
                                <Border Background="{DynamicResource AccentBrush}" Margin="1,1,0,0" />
                            </UniformGrid>
                        </Grid>
                        <TextBlock Text="ZenVF" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Style="{StaticResource PboPill}" Margin="0,0,8,0"
                                ToolTip="{Binding PboEvidenceText}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PboState}" Value="on">
                                                    <Setter Property="Fill" Value="{DynamicResource YellowBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PboState}" Value="off">
                                                    <Setter Property="Fill" Value="{DynamicResource GreenBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding PboSummary}" Margin="7,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusPillText}">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PboState}" Value="on">
                                                    <Setter Property="Foreground" Value="{DynamicResource YellowBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PboState}" Value="off">
                                                    <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DemoPill}" Margin="0,0,8,0"
                                Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="DEMO" Style="{StaticResource StatusPillText}"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource YellowBrush}" />
                        </Border>

                        <Border Style="{StaticResource AdminPill}" Margin="0,0,10,0"
                                ToolTip="{Binding AdminTooltip}"
                                AutomationProperties.Name="{Binding AdminText}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="14" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                                      Data="M6,0 L12,2.2 V6.3 C12,9.4 9.6,11.6 6,12.8 C2.4,11.6 0,9.4 0,6.3 V2.2 Z">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource GreenBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{Binding AdminText}" Margin="7,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusPillText}">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}"
                                VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Button Content="&#xE790;" Style="{StaticResource TitleBarButton}" Click="Theme_Click"
                                FontSize="14" ToolTip="外观与主题" AutomationProperties.Name="外观与主题" />
                        <Button Content="&#xE921;" Style="{StaticResource TitleBarButton}" Click="Minimize_Click" ToolTip="最小化" />
                        <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource TitleBarButton}"
                                Click="Maximize_Click" ToolTip="最大化" />
                        <Button Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="关闭" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Workbench -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Conditions rail -->
                <Border Grid.Column="0" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="18,16,18,14">

                                <Grid>
                                    <TextBlock Text="处理器" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding ArchitectureText}" Style="{StaticResource PlateCaption}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding CpuDisplayName}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                                           Margin="0,6,0,0" ToolTip="{Binding CpuName}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border Style="{StaticResource Tag}" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding CoreText}" FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="10.5" Foreground="{DynamicResource MutedBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource Tag}" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding CcdText}" FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="10.5" Foreground="{DynamicResource MutedBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource Tag}" Background="{DynamicResource AccentSoftBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            Visibility="{Binding Has3DCache, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="3D V-CACHE" FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- Label, leader and value share one bottom baseline; values
                                     right-align so "1.00" lines up with "5700 MHz". -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="默认最高" Style="{StaticResource KvLabel}" />
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DotLeader}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding StockFMaxText}" Style="{StaticResource StatValue}" />

                                    <TextBlock Grid.Row="1" Text="当前最高" Style="{StaticResource KvLabel}" />
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DotLeader}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CurrentFMaxText}" Style="{StaticResource StatValue}"
                                               Foreground="{DynamicResource AccentBrush}" />

                                    <TextBlock Grid.Row="2" Text="原始最高" Style="{StaticResource KvLabel}" />
                                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DotLeader}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding OriginalFMaxText}" Style="{StaticResource StatValue}" />

                                    <TextBlock Grid.Row="3" Text="PBO Scalar" Style="{StaticResource KvLabel}" />
                                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource DotLeader}" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ScalarText}" Style="{StaticResource StatValue}" />
                                </Grid>

                                <Border Style="{StaticResource SectionRule}" Margin="0,14,0,0" />

                                <!-- FMax takeover -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="最高频率接管" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding PboToggleHint}" Style="{StaticResource SmallMuted}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                   ToolTip="{Binding PboEvidenceText}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SwitchButton}" VerticalAlignment="Top"
                                            Command="{Binding TogglePboCommand}"
                                            IsEnabled="{Binding CanTogglePbo}"
                                            ToolTip="打开后才能修改 CPU 的最高加速频率"
                                            AutomationProperties.Name="最高频率接管开关" />
                                </Grid>

                                <Border Style="{StaticResource Inset}" Margin="0,12,0,0" Padding="10,7">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SmuStatusText}" FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionRule}" Margin="0,14,0,0" />

                                <!-- Sweep -->
                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="扫描范围" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding StepCountText, StringFormat={}{0} 档}"
                                               Style="{StaticResource Readout}" FontSize="13"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding RangeHintText}" Style="{StaticResource SmallMuted}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RangeHintText}" />

                                <!-- Range pair on top, timing triple below: grouped by
                                     meaning, so no grid cell is left empty. -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" ToolTip="要测试的最高实际加速频率。">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="起始频率 MHz" />
                                        <TextBox Style="{StaticResource NumericTextBox}"
                                                 Text="{Binding StartFMaxText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="填 CPU 能加速到的最高频率，不是写入上限。程序会自动换算。" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" ToolTip="要测试的最低实际加速频率。">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="结束频率 MHz" />
                                        <TextBox Style="{StaticResource NumericTextBox}"
                                                 Text="{Binding EndFMaxText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="默认是这颗 CPU 的基础频率。程序会自动换算写入值。" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" ToolTip="每隔多少 MHz 测一档；默认 100。">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="步进 MHz" />
                                        <TextBox Style="{StaticResource NumericTextBox}"
                                                 Text="{Binding StepText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" ToolTip="先让 CPU 跑一会儿，等频率稳定；默认 5 秒。">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="预热 秒" />
                                        <TextBox Style="{StaticResource NumericTextBox}"
                                                 Text="{Binding WarmupText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4"
                                                ToolTip="记录数据的时长；默认 5 秒。曲线跳动大时可改 10 秒。">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="采样 秒" />
                                        <TextBox Style="{StaticResource NumericTextBox}"
                                                 Text="{Binding SampleText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="CCD" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                                <!-- Two equal columns that fill the rail; the cards used to be
                                     a fixed 152px and left a ragged gap on the right. -->
                                <ItemsControl ItemsSource="{Binding CcdOptions}" Margin="-4,0,-4,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="46" Margin="4,0,4,8" Padding="10,0"
                                                    ToolTip="{Binding Detail}">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Inset}">
                                                        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="11"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="停止、完成或退出时恢复原始 FMax。" Style="{StaticResource SmallMuted}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />

                                <Border Background="{DynamicResource WarningSoftBrush}"
                                        BorderBrush="{DynamicResource PboOnBorderBrush}" BorderThickness="1"
                                        Padding="10" Margin="0,6,0,0"
                                        Visibility="{Binding DriverWarningVisible, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="需要 PawnIO 驱动" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource YellowBrush}" />
                                        <TextBlock Text="{Binding DriverWarningText}" FontSize="10.5"
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                                   Margin="0,4,0,0" LineHeight="15" />
                                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                                Margin="0,8,0,0" Command="{Binding InstallPawnIoCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="安装 PawnIO" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Pinned run controls -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource RedBrush}"
                                           FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,7"
                                           Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StageText}" FontSize="12.5"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0}%}"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0"
                                               VerticalAlignment="Bottom" />
                                </Grid>
                                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding ProgressTimeText}" Style="{StaticResource SmallMuted}"
                                           HorizontalAlignment="Right" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="40" />
                                    </Grid.RowDefinitions>

                                    <Button Grid.ColumnSpan="3" Style="{StaticResource PrimaryButton}" Padding="10,0"
                                            Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"
                                            ToolTip="所有核心同时负载；每档预热和采样时间与上方设置一致。"
                                            AutomationProperties.Name="开始全核测试"
                                            AutomationProperties.HelpText="{Binding PlanSummaryText}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Viewbox Width="10" Height="10" Margin="0,0,7,0">
                                                <Path Data="M0,0 L10,6 L0,12 Z" Fill="{DynamicResource AccentTextBrush}" />
                                            </Viewbox>
                                            <TextBlock Text="{Binding StartButtonText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Row="2" Style="{StaticResource SecondaryButton}" Padding="10,0"
                                            Command="{Binding SingleCoreStartCommand}" IsEnabled="{Binding CanStartSingleCore}"
                                            ToolTip="每个频率档位依次只测一个物理核心；电压读取 CPU VDDCR_VDD，结果看“单核 V/F”页。"
                                            AutomationProperties.Name="开始每核单独测试"
                                            AutomationProperties.HelpText="{Binding SingleCorePlanText}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Viewbox Width="10" Height="10" Margin="0,0,7,0">
                                                <Path Data="M0,0 L10,6 L0,12 Z" Fill="{DynamicResource TextBrush}" />
                                            </Viewbox>
                                            <TextBlock Text="{Binding SingleCoreButtonText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource DangerButton}"
                                            Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}"
                                            Padding="0"
                                            ToolTip="停止当前测试；完成、停止或退出程序时会自动恢复原始频率。"
                                            AutomationProperties.Name="停止测试">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Viewbox Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center">
                                                <Path Data="M0,0 H10 V10 H0 Z" Fill="{DynamicResource DangerButtonTextBrush}" />
                                            </Viewbox>
                                            <TextBlock Text="停止" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Chart and tape -->
                <Grid Grid.Column="1" Margin="14,14,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="178" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Plate}" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Margin="18,14,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="电压—频率响应" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ChartSubtitle}" Style="{StaticResource SmallMuted}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource EclkPill}" Margin="8,0,0,0" Padding="6,2"
                                            Visibility="{Binding IsEclkDetected, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding EclkTooltip}"
                                            AutomationProperties.Name="{Binding EclkText}">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                                                <Path Data="{StaticResource EclkWaveGeometry}"
                                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Viewbox>
                                            <TextBlock Text="{Binding EclkText}" FontSize="11" FontWeight="SemiBold"
                                                       Margin="5,0,0,0" Foreground="{DynamicResource AccentBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource GhostButton}" Click="CoreVoltage_Click"
                                            IsEnabled="{Binding CanShowCoreVoltages}" Margin="0,0,4,0"
                                            ToolTip="查看同一频率下每个核心的电压">
                                        <TextBlock Text="每核电压" VerticalAlignment="Center" />
                                    </Button>
                                    <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}"
                                            VerticalAlignment="Center" Margin="2,0,6,0" />
                                    <Button Content="&#xE71F;" Style="{StaticResource IconButton}" Click="ZoomOut_Click"
                                            IsEnabled="{Binding CanExport}" ToolTip="缩小坐标图（也可滚轮向下）"
                                            AutomationProperties.Name="缩小坐标图" />
                                    <Button Content="&#xE8A3;" Style="{StaticResource IconButton}" Click="ZoomIn_Click"
                                            IsEnabled="{Binding CanExport}" ToolTip="放大坐标图（也可滚轮向上）"
                                            AutomationProperties.Name="放大坐标图" />
                                    <Button Style="{StaticResource GhostButton}" Click="ResetZoom_Click"
                                            IsEnabled="{Binding CanExport}" ToolTip="重置坐标图缩放和平移"
                                            AutomationProperties.Name="重置坐标图缩放和平移">
                                        <TextBlock Text="重置" VerticalAlignment="Center" />
                                    </Button>
                                    <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}"
                                            VerticalAlignment="Center" Margin="6,0,6,0" />
                                    <Button Style="{StaticResource GhostButton}" Click="ExportPng_Click"
                                            IsEnabled="{Binding CanExport}" ToolTip="导出当前图表为 PNG">
                                        <TextBlock Text="PNG" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Click="ExportCsv_Click"
                                            IsEnabled="{Binding CanExport}" ToolTip="导出逐核逐档原始数据为 CSV">
                                        <TextBlock Text="CSV" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Click="ExportMarkdown_Click"
                                            IsEnabled="{Binding CanExport}" ToolTip="导出当前结果的 Markdown 报告">
                                        <TextBlock Text="MD" VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <TabControl x:Name="ChartTabs" Grid.Row="1" Style="{StaticResource ChartTabControl}"
                                        SelectionChanged="ChartTabs_SelectionChanged">
                                <TabItem Header="最高电压核心" Style="{StaticResource ChartTabItem}">
                                    <Grid>
                                        <oxy:PlotView x:Name="MainPlotView" Model="{Binding PlotModel}"
                                                      Background="Transparent" BorderThickness="0" Margin="2,0,8,2"
                                                      PreviewMouseMove="MainPlotView_MouseMove"
                                                      MouseLeave="MainPlotView_MouseLeave" />
                                        <Canvas x:Name="MainHoverLayer" IsHitTestVisible="False" ClipToBounds="True">
                                            <Border x:Name="MainHoverTip" Style="{StaticResource ChartHoverTip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="MainHoverSwatch" Width="7" Height="7"
                                                             VerticalAlignment="Top" Margin="0,4,8,0" Fill="#5BC0BE" />
                                                    <StackPanel>
                                                        <TextBlock x:Name="MainHoverTitle" Style="{StaticResource ChartHoverTitle}"
                                                                   Text="CCD0 · MAX CORE" />
                                                        <TextBlock x:Name="MainHoverDetail" Style="{StaticResource ChartHoverDetail}"
                                                                   Text="— MHz · — V" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Canvas>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="每核 V/F" Style="{StaticResource ChartTabItem}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Margin="18,0,18,0"
                                                   Text="每条线代表一个核心；悬停查看频率和电压。"
                                                   FontSize="11.5" Foreground="{DynamicResource FaintBrush}"
                                                   VerticalAlignment="Center" />
                                        <Grid Grid.Row="1">
                                            <oxy:PlotView x:Name="PerCorePlotView"
                                                          Model="{Binding PerCorePlotModel}" Background="Transparent"
                                                          BorderThickness="0" Margin="2,0,8,2"
                                                          PreviewMouseMove="PerCorePlotView_MouseMove"
                                                          MouseLeave="PerCorePlotView_MouseLeave" />
                                            <Canvas x:Name="CoreHoverLayer" IsHitTestVisible="False" ClipToBounds="True">
                                                <Border x:Name="CoreHoverTip" Style="{StaticResource ChartHoverTip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse x:Name="CoreHoverSwatch" Width="7" Height="7"
                                                                 VerticalAlignment="Top" Margin="0,4,8,0" Fill="#5BC0BE" />
                                                        <StackPanel>
                                                            <TextBlock x:Name="CoreHoverTitle" Style="{StaticResource ChartHoverTitle}"
                                                                       Text="CCD0 · Core 0" />
                                                            <TextBlock x:Name="CoreHoverDetail" Style="{StaticResource ChartHoverDetail}"
                                                                       Text="— MHz · — V" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Canvas>
                                        </Grid>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="单核 V/F" Style="{StaticResource ChartTabItem}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Margin="18,0,18,0"
                                                   Text="每个频率只测一个核心；电压来自 CPU VDDCR_VDD。"
                                                   FontSize="11.5" Foreground="{DynamicResource FaintBrush}"
                                                   VerticalAlignment="Center" />
                                        <Grid Grid.Row="1">
                                            <oxy:PlotView x:Name="SingleCorePlotView"
                                                          Model="{Binding SingleCorePlotModel}" Background="Transparent"
                                                          BorderThickness="0" Margin="2,0,8,2"
                                                          PreviewMouseMove="SingleCorePlotView_MouseMove"
                                                          MouseLeave="SingleCorePlotView_MouseLeave" />
                                            <Canvas x:Name="SingleCoreHoverLayer" IsHitTestVisible="False" ClipToBounds="True">
                                                <Border x:Name="SingleCoreHoverTip" Style="{StaticResource ChartHoverTip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse x:Name="SingleCoreHoverSwatch" Width="7" Height="7"
                                                                 VerticalAlignment="Top" Margin="0,4,8,0" Fill="#5BC0BE" />
                                                        <StackPanel>
                                                            <TextBlock x:Name="SingleCoreHoverTitle" Style="{StaticResource ChartHoverTitle}"
                                                                       Text="CCD0 · Core 0" />
                                                            <TextBlock x:Name="SingleCoreHoverDetail" Style="{StaticResource ChartHoverDetail}"
                                                                       Text="— MHz · — V" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Canvas>
                                        </Grid>
                                    </Grid>
                                </TabItem>
                            </TabControl>

                            <!-- Signature: core floorplan -->
                            <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                                    Background="{DynamicResource InsetBrush}" Padding="18,12,18,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="核心版图" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Text="{Binding CoreMapCaption}" Style="{StaticResource SectionLabel}"
                                                       Foreground="{DynamicResource FaintBrush}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding CoreMap}" Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="78" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Rectangle Width="2" Height="12" Fill="{Binding Accent}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas"
                                                                           FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           Margin="5,0,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Meta}" FontSize="10.5"
                                                                       Foreground="{DynamicResource FaintBrush}"
                                                                       Margin="7,1,0,0" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Meta}" />
                                                        </StackPanel>

                                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Cores}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Rows="1" HorizontalAlignment="Left" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="68" Height="44" Margin="0,0,5,0"
                                                                            ToolTip="{Binding Tooltip}">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="{DynamicResource CoreBlockBrush}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource CoreBlockBorderBrush}" />
                                                                                <Setter Property="BorderThickness" Value="1" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsMax}" Value="True">
                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource CopperBrush}" />
                                                                                        <Setter Property="Background" Value="{DynamicResource CopperSoftBrush}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <Grid>
                                                                            <Rectangle Height="3" VerticalAlignment="Bottom"
                                                                                       Fill="{DynamicResource CopperBrush}"
                                                                                       Opacity="{Binding Heat}" />
                                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                                <TextBlock Text="{Binding Label}"
                                                                                           FontFamily="Cascadia Mono, Consolas"
                                                                                           FontSize="10"
                                                                                           Foreground="{DynamicResource FaintBrush}"
                                                                                           HorizontalAlignment="Center" />
                                                                                <TextBlock Text="{Binding VoltageText}"
                                                                                           FontFamily="Cascadia Mono, Consolas"
                                                                                           FontSize="12.5" FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           HorizontalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                                        <StackPanel Margin="0,0,20,0">
                                            <TextBlock Text="PACKAGE" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Text="{Binding PackagePowerText}" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Border Width="1" Height="34" Background="{DynamicResource BorderBrush}" Margin="0,0,20,0" />
                                        <StackPanel Margin="0,0,20,0">
                                            <TextBlock Text="TCTL" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Text="{Binding TctlText}" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Border Width="1" Height="34" Background="{DynamicResource BorderBrush}" Margin="0,0,20,0" />
                                        <StackPanel>
                                            <TextBlock Text="AVG CLOCK" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Text="{Binding AverageClockText}" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Measurement tape -->
                    <Border Grid.Row="2" Style="{StaticResource Plate}" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="18,8,8,0">
                                <TextBlock Text="运行日志" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource GhostButton}" Click="CopyLog_Click" ToolTip="复制全部日志">
                                        <TextBlock Text="复制" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Click="ClearLog_Click" ToolTip="清空日志">
                                        <TextBlock Text="清空" VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding LogItems}" Margin="18,0,6,10"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                       Foreground="{DynamicResource LogTimeBrush}" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding LevelText}" Style="{StaticResource LogLevelText}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12"
                                                       Foreground="{DynamicResource LogTextBrush}" TextWrapping="Wrap" LineHeight="18" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Status -->
            <Border Grid.Row="2" Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                   Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SmuStatusText}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                                   Foreground="{DynamicResource FaintBrush}" />
                        <Border Width="1" Height="12" Background="{DynamicResource BorderBrush}" Margin="12,0" />
                        <TextBlock Text="{Binding PawnIoStatusText}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                                   Foreground="{DynamicResource FaintBrush}" />
                        <Border Width="1" Height="12" Background="{DynamicResource BorderBrush}" Margin="12,0" />
                        <TextBlock Text="{Binding AdminText}" FontSize="11" Foreground="{DynamicResource FaintBrush}" />
                        <Border Width="1" Height="12" Background="{DynamicResource BorderBrush}" Margin="12,0" />
                        <TextBlock Text="v1.0.7" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                                   Foreground="{DynamicResource FaintBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
